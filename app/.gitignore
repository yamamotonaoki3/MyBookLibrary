# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# AivenのCA証明書は秘密鍵ではなく公開証明書（サーバー検証専用）であり、
# Vercel等のGitベースのデプロイ先に確実に配置するためコミット対象とする。
!certs/aiven-ca.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# PWA Service Worker (generated by @ducanh2912/next-pwa)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/worker-*.js
/public/fallback-*.js

# 芥川賞データ取り込み用の作業ファイル（コミット予定なし）
/scripts/build-akutagawa-*.mjs
/scripts/enrich-akutagawa-isbn.mjs
/data/akutagawa/

# 直木賞データ取り込み用の作業ファイル（コミット予定なし）
/scripts/build-naoki-*.mjs
/scripts/fix-csv-award-ids.mjs
/data/naoki/

# 本屋大賞データ取り込み用の作業ファイル（コミット予定なし）
/scripts/download-honya-history.mjs
/data/honya/
