# 実DB統合テスト用（#433）。app ディレクトリでこのファイルをコピーして .env.test を作る。
#
#   cp .env.test.example .env.test
#
# DATABASE_URL はリポジトリ直下の .env（docker-compose.yml の db-test サービス）に
# 設定した認証情報・ポート(3307)・DB名(mybooklibrary_test)に合わせる。
DATABASE_URL="mysql://itest_user:changeme@localhost:3307/mybooklibrary_test"

# 外部APIキーはダミー値でよい。実DB統合テストの対象（user/delete, favorite-authors,
# reviews report, reading-status）は外部APIを呼ばないため。
RAKUTEN_APP_ID=dummy
RAKUTEN_ACCESS_KEY=dummy
CALIL_API_KEY=dummy
AUTH_SECRET=dummy-test-secret-not-for-production
CRON_SECRET=dummy
