# ローカル開発用（Next.js の規約により .env.local を使う）。
# このファイルをコピーして .env.local を作り、実際の値を設定する。
# .env.local は .gitignore 対象でコミットされない。
#
#   cp .env.local.example .env.local
#
# .env.test（E2E/結合テスト用）・.env.aiven-staging（Aiven検証用）とは
# 別ファイルとして管理する。

# docker-compose.yml の db サービス（ローカルMySQL）への接続文字列。
# ユーザー名・パスワードはリポジトリ直下の .env（DB_MYSQL_USER 等）と合わせる。
DATABASE_URL="mysql://changeme:changeme@localhost:3306/mybooklibrary"

# 楽天ブックス Web Service（https://webservice.rakuten.co.jp/ で取得）
RAKUTEN_APP_ID=changeme
RAKUTEN_ACCESS_KEY=changeme

# カーリル 図書館API（https://calil.jp/api/dashboard/ で取得）
CALIL_API_KEY=changeme

# NextAuth.js
# AUTH_SECRET は `openssl rand -base64 32` で生成する
AUTH_SECRET=changeme

# Google OAuth（Google Cloud Console で取得。未設定でもメール+パスワード認証は動作する）
AUTH_GOOGLE_ID=changeme
AUTH_GOOGLE_SECRET=changeme

# Cron（新刊チェック）のセキュリティトークン。16文字以上の推測されにくい値にする
CRON_SECRET=changeme

# シードスクリプト用ユーザー設定（未設定時はデフォルト値が使われる）
SEED_ADMIN_EMAIL=changeme
SEED_ADMIN_PASSWORD=changeme
SEED_TEST_EMAIL=changeme
SEED_TEST_PASSWORD=changeme
