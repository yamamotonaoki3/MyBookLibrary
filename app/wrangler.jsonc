// Cloudflare Workers / D1 の設定。docs/cloudflare-d1-migration-plan.md §6、手順は docs/cloudflare-deploy.md を参照。
// Worker のビルドは npm run build:worker（OpenNext + Prisma の wasm の同梱。scripts/build-worker.mjs）。
//
// 環境は 2 つ。トップレベルが本番（production）、`env.staging` がステージング。
//   本番:         wrangler deploy                … Worker 名 mybooklibrary / D1 mybooklibrary-db
//   ステージング: wrangler deploy --env staging … Worker 名 mybooklibrary-staging / D1 mybooklibrary-staging-db
// wrangler では、バインディング（D1）と vars は環境に継承されないため、環境ごとに書く。triggers は継承されるため、
// ステージングでは Cron を空配列で上書きして無効にする（省略すると本番の Cron を引き継ぐ）。
// ローカル実行（wrangler dev --local、npm run smoke:worker）はトップレベルを使い、D1 の ID は使われない。
// secret（AUTH_SECRET・CRON_SECRET など）は、このファイルに書かず wrangler secret put で環境ごとに登録する。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mybooklibrary",
  // OpenNext の Worker に Cron の scheduled ハンドラを足したカスタムエントリ（ビルド後の .open-next/worker.js を使う）
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // 稼働中のバージョン（ID・タグ・時刻）を GET /api/version で返すためのバインディング。環境に継承されないため、ステージングにも書く。
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // ---- 本番（production） ----
  // 新刊チェックの Cron（毎日 UTC 00:00 = JST 09:00。AWS の EventBridge と同じ）。
  // scheduled ハンドラは worker/index.mjs。CRON_SECRET は Worker の secret（wrangler secret put）で設定する。
  "triggers": { "crons": ["0 0 * * *"] },
  "vars": {
    // 公開 URL（workers.dev）。NextAuth の AUTH_URL と、Cron が内部呼び出しで使う origin。
    "AUTH_URL": "https://mybooklibrary.nyproducts.workers.dev",
    "AUTH_TRUST_HOST": "true",
    "CRON_TARGET_ORIGIN": "https://mybooklibrary.nyproducts.workers.dev",
    // 楽天ブックス API に Referer / Origin として送る、アプリ登録（許可された Web サイト）のドメイン
    "RAKUTEN_ALLOWED_ORIGIN": "https://mybooklibrary.nyproducts.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mybooklibrary-db",
      // wrangler d1 create mybooklibrary-db で作成した D1 の ID（秘密情報ではない）。ローカル実行（--local）では使われない。
      "database_id": "dd2f0ed7-5d12-4d7d-8722-97765ff4089b",
      "migrations_dir": "prisma/d1/migrations"
    }
  ],

  "env": {
    // ---- ステージング（staging） ----
    "staging": {
      // Worker 名は mybooklibrary-staging（env 名が付く）。公開 URL は https://mybooklibrary-staging.nyproducts.workers.dev
      // Cron は無効（本番との二重通知を防ぐ。手動実行で確認する）。
      "triggers": { "crons": [] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "AUTH_URL": "https://mybooklibrary-staging.nyproducts.workers.dev",
        "AUTH_TRUST_HOST": "true",
        "CRON_TARGET_ORIGIN": "https://mybooklibrary-staging.nyproducts.workers.dev",
        "RAKUTEN_ALLOWED_ORIGIN": "https://mybooklibrary-staging.nyproducts.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mybooklibrary-staging-db",
          // wrangler d1 create mybooklibrary-staging-db で作成した D1 の ID（秘密情報ではない）。
          "database_id": "e788d5bf-9174-44f7-8ac0-934e81c08f32",
          "migrations_dir": "prisma/d1/migrations"
        }
      ]
    }
  }
}
