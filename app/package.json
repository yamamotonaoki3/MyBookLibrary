{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate && prisma generate --schema prisma/d1/schema.prisma",
    "prisma:generate:d1": "prisma generate --schema prisma/d1/schema.prisma",
    "build:worker": "node scripts/build-worker.mjs",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "test": "jest --selectProjects node jsdom",
    "test:watch": "jest --selectProjects node jsdom --watch",
    "test:coverage": "jest --selectProjects node jsdom --coverage",
    "test:integration": "dotenv -e .env.test -- jest --selectProjects integration --runInBand",
    "test:integration:d1": "jest --selectProjects integration-d1 --runInBand",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "start": "next start",
    "lint": "eslint",
    "enrich": "tsx scripts/enrich-books.ts",
    "seed:dev": "tsx prisma/seed.dev.ts",
    "migration:dump-checksum": "tsx prisma/scripts/migration/dump-checksum.ts",
    "migration:restore": "tsx prisma/scripts/migration/restore-to-target.ts",
    "migration:verify": "tsx prisma/scripts/migration/verify-migration.ts",
    "migration:backfill": "tsx prisma/scripts/backfill-book-owner.ts",
    "audit:production-readonly": "tsx prisma/scripts/audit-production-readonly.ts",
    "audit:email-normalization": "tsx prisma/scripts/audit-email-normalization.ts",
    "schema:d1": "tsx prisma/scripts/generate-d1-schema.ts",
    "d1:migration:new": "tsx prisma/scripts/d1-migration.ts new",
    "d1:migration:check": "tsx prisma/scripts/d1-migration.ts check",
    "d1:migrate:local": "wrangler d1 migrations apply mybooklibrary-db --local",
    "d1:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "d1:migrate:production": "wrangler d1 migrations apply DB --remote",
    "deploy:staging": "npm run d1:migrate:staging && wrangler deploy --env staging",
    "deploy:production": "npm run d1:migrate:production && wrangler deploy",
    "schema:d1:check": "tsx prisma/scripts/generate-d1-schema.ts --check && prisma validate --schema prisma/d1/schema.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.5.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.17.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.31",
    "pino": "^10.3.1",
    "prisma": "6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
