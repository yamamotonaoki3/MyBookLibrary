generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  image           String?
  emailVerified   DateTime?        @map("email_verified")
  password        String?
  role            String           @default("user")
  loginFailCount  Int              @default(0) @map("login_fail_count")
  lockedUntil     DateTime?        @map("locked_until")
  createdAt       DateTime         @default(now()) @map("created_at")
  favoriteAuthors FavoriteAuthor[]
  readingStatuses ReadingStatus[]
  reviews         Review[]
  likes           Like[]
  notifications   Notification[]
  reports         Report[]
  accounts           Account[]
  sessions           Session[]
  contactInquiries   ContactInquiry[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Author {
  id              Int              @id @default(autoincrement())
  name            String
  books           Book[]
  favoriteAuthors FavoriteAuthor[]

  @@map("authors")
}

model Book {
  id              Int             @id @default(autoincrement())
  authorId        Int             @map("author_id")
  title           String
  isbn            String?         @unique
  publishedAt     DateTime        @map("published_at") @db.Date
  coverImageUrl   String?         @map("cover_image_url")
  source          String          @default("rakuten")
  author          Author          @relation(fields: [authorId], references: [id])
  awardEntries    AwardEntry[]
  readingStatuses ReadingStatus[]
  reviews         Review[]

  @@map("books")
}

model Award {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  awardEntries AwardEntry[]

  @@map("awards")
}

model AwardEntry {
  id      Int    @id @default(autoincrement())
  bookId  Int    @map("book_id")
  awardId Int    @map("award_id")
  year    Int
  type    String
  book    Book   @relation(fields: [bookId], references: [id])
  award   Award  @relation(fields: [awardId], references: [id])

  @@unique([bookId, awardId, year])
  @@map("award_entries")
}

model FavoriteAuthor {
  id       Int     @id @default(autoincrement())
  userId   Int     @map("user_id")
  authorId Int     @map("author_id")
  notify   Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id])
  author   Author  @relation(fields: [authorId], references: [id])

  @@unique([userId, authorId])
  @@map("favorite_authors")
}

model ReadingStatus {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bookId    Int      @map("book_id")
  status    String   @default("unread")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])
  book      Book     @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@map("reading_statuses")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bookId    Int      @map("book_id")
  body      String   @db.Text
  isSpoiler Boolean  @default(false) @map("is_spoiler")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  book      Book     @relation(fields: [bookId], references: [id])
  likes     Like[]
  reports   Report[]

  @@map("reviews")
}

model Like {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  reviewId Int    @map("review_id")
  user     User   @relation(fields: [userId], references: [id])
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@map("likes")
}

model Report {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @map("review_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reviewId])
  @@map("reports")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  content   String
  bookIsbn  String?   @map("book_isbn")
  bookTitle String?   @map("book_title")
  isRead    Boolean   @default(false) @map("is_read")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, type, bookIsbn])
  @@map("notifications")
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  category  String
  subject   String
  body      String   @db.Text
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_inquiries")
}
