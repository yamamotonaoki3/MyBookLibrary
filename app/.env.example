# このファイルは .env.local のテンプレートです。
# コピーして .env.local を作成し、各値を環境に合わせて設定してください。

DATABASE_URL="mysql://mysql:mysql@localhost:3306/mybooklibrary"

RAKUTEN_APP_ID="your-rakuten-app-id"
RAKUTEN_ACCESS_KEY="your-rakuten-access-key"

# Vercel Cron のセキュリティトークン（Vercelダッシュボードにも同じ値を設定すること）
CRON_SECRET="your-cron-secret"

# NextAuth.js
# AUTH_SECRET は `openssl rand -base64 32` で生成してください
AUTH_SECRET="your-auth-secret"

# Google OAuth（Google Cloud Console で取得してください）
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# シードスクリプト用ユーザー設定（未設定時はデフォルト値が使われます）
# 本番環境では必ず強力なパスワードを設定してください
SEED_ADMIN_EMAIL=admin@mybooklibrary.local
SEED_ADMIN_PASSWORD=your-strong-admin-password
SEED_TEST_EMAIL=test@example.com
SEED_TEST_PASSWORD=your-test-password
