# 移行元（本番/リハーサル元）DBのdump取得用（Issue #478）。
# app ディレクトリでこのファイルをコピーして .env.migration-source を作る。
#
#   cp .env.migration-source.example .env.migration-source
#
# dump-production.sh（prisma/scripts/migration/dump-production.sh）が読み込む環境変数。
# ここに書いた値はコミットしないこと（.gitignoreの app/.env.* パターンで除外される）。
#
#   npx dotenv -e .env.migration-source -o --no-expand -- ./prisma/scripts/migration/dump-production.sh ./prisma/scripts/migration/dumps
#
# 注意: `set -a; source .env.migration-source; set +a` のようにシェルの`source`で
# 読み込んではいけない。パスワードに`$`やバッククォート等のシェル特殊文字が含まれる場合、
# 値がシェルコードとして展開・実行されてしまう危険がある。上記のdotenv-cli経由の読み込みは
# 値を展開せずそのまま子プロセスの環境変数として渡すため安全。
#
# 値は全てダミー。実際のホスト名・認証情報に置き換えること。
SOURCE_DB_HOST="changeme.example-rds.com"
SOURCE_DB_PORT="3306"
SOURCE_DB_USER="changeme"
SOURCE_DB_PASSWORD="changeme"
SOURCE_DB_NAME="changeme"

# --source-live（本番切替#475時のみ）でverify-migration.tsが直接照会する接続文字列。
# 書き込み凍結中の移行元DBを指す。リハーサル(#480)では設定不要。
SOURCE_DATABASE_URL="mysql://changeme:changeme@changeme.example-rds.com:3306/changeme"
