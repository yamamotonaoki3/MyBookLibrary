# 移行先（リハーサル用/本番切替用）DBの接続情報（Issue #478）。
# app ディレクトリでこのファイルをコピーして .env.migration-target を作る。
#
#   cp .env.migration-target.example .env.migration-target
#
# restore-to-target.ts / verify-migration.ts が読み込む環境変数。
# ここに書いた値はコミットしないこと（.gitignoreの app/.env.* パターンで除外される）。
#
#   npx dotenv -e .env.migration-target -o -- npx tsx prisma/scripts/migration/restore-to-target.ts --dump <path>
#
# 値は全てダミー。実際のホスト名・認証情報に置き換えること。

# 移行先として許可するホスト名（カンマ区切り、完全一致）。
# 誤って本番へ接続・書き込みしないための許可リスト（migrationGuard.tsが検証する）。
MIGRATION_TARGET_ALLOWED_HOSTS="changeme-staging.example-aiven.com"

# 本番DBのホスト名（比較専用。この値を使って実際に接続することはない）。
# MIGRATION_TARGET_ALLOWED_HOSTSに誤って本番ホストを含めてしまった場合の保険として使う。
PRODUCTION_DB_HOST="changeme-prod.example-rds.com"

DATABASE_URL="mysql://changeme:changeme@changeme-staging.example-aiven.com:12345/defaultdb?sslaccept=strict&sslcert=../certs/aiven-ca.pem"
