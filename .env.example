# docker-compose.yml の db / db-test サービス用。
# このファイルをコピーして .env を作り、実際の値（ランダムな文字列）を設定する。
# .env は .gitignore 対象でコミットされない。
#
#   cp .env.example .env
#
# 開発用DB（db サービス）。
DB_MYSQL_ROOT_PASSWORD=changeme
DB_MYSQL_USER=changeme
DB_MYSQL_PASSWORD=changeme

# 実DB統合テスト用（db-test サービス、#433）。
DB_TEST_MYSQL_ROOT_PASSWORD=changeme
DB_TEST_MYSQL_USER=changeme
DB_TEST_MYSQL_PASSWORD=changeme
